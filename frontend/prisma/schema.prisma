generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rate {
  id       Int      @id @default(autoincrement())
  date     DateTime
  usdToEur Float?
  usdcToEur Float?
  eurToUsd Float?
  eurToUsdc Float?
  usdToGbp Float?
  usdcToGbp Float?
  gbpToUsd Float?
  gbpToUsdc Float?
  usdToTwd Float?
  usdcToTwd Float?
  twdToUsd Float?
  twdToUsdc Float?
}